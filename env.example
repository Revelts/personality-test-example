# Google Tag Manager Configuration
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Enable GTM in development (optional, default: false)
# Set to 'true' to test GTM in local development
NEXT_PUBLIC_GTM_ENABLED=false

# Google Analytics 4 (configured via GTM)
# No need for GA4 ID here - managed in GTM

# Meta Pixel (configured via GTM)
# No need for Pixel ID here - managed in GTM

# Microsoft Clarity
NEXT_PUBLIC_CLARITY_PROJECT_ID=CLARITY_PROJECT_ID

# Environment
NEXT_PUBLIC_ENV=development

# Base URL for Open Graph and absolute URLs
# Production: https://your-domain.com
# Development: http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000
